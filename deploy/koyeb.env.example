# Paste into Koyeb's Environment variables -> Bulk Edit, then fill the four
# required fields in Koyeb. Do not commit real credentials to this file.
BOT_TOKEN=
OWNER_ID=
TELEGRAM_API=
TELEGRAM_HASH=

# The bootstrap derives BASE_URL from KOYEB_PUBLIC_DOMAIN when left empty.
BASE_URL=
BASE_URL_PORT=8080
PORT=8080
MLTB_LOW_MEMORY=true
QUEUE_ALL=1
QUEUE_DOWNLOAD=1
QUEUE_UPLOAD=1

# Optional MongoDB. Keep a separate database from file-to-link services.
DATABASE_URL=
DATABASE_NAME=mltb

# Keep blank unless you deliberately configure these integrations.
JD_EMAIL=
JD_PASS=
UPSTREAM_REPO=
